# Supabase Configuration
# Required: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase Anon / Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional (Recommended for server operations): Supabase Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
# Max allowed single file upload size in MB (default: 100)
MAX_FILE_SIZE_MB=100

# App URL for Metadata & OpenGraph image resolution on Vercel
NEXT_PUBLIC_APP_URL=https://zeesu-send.vercel.app
